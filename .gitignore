/target
**/*.rs.bk
*.swp
.DS_Store

# Oracle build artifacts and downloaded sources are reproducible from the
# manifests under forensics/sources/; keep the raw trees and binaries out of
# version control (the manifests and receipts are the committed evidence).
/forensics/oracle/work/
/forensics/oracle/build/
/forensics/sources/*.tar.gz
/forensics/sources/*.tar.xz
/forensics/sources/*.asc
/bind9-rs-tools/forensics/oracle/work/
/bind9-rs-tools/forensics/oracle/build/
/bind9-rs-tools/forensics/sources/*.tar.gz
/bind9-rs-tools/forensics/sources/*.tar.xz
/bind9-rs-tools/forensics/sources/*.asc

# Court run artifacts that are pure build products (not evidence).
/forensics/courts/**/work/
/bind9-rs-tools/forensics/courts/**/work/
