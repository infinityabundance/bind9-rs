        {
          "args": "(query_ctx_t *qctx, filter_aaaa_t mode, const dns_name_t *name, dns_rdatatype_t type, bool only_if_a_exists)",
          "brief": "Check whether an RRset of given 'type' is present at given 'name'. If it is found and either it is not signed or the combination of query flags and configured processing 'mode' allows it, mark the RRset and its associated signatures as already rendered to prevent them from appearing in the response message stored in 'qctx'. If 'only_if_a_exists' is true, an RRset of type A must also exist at 'name' in order for the above processing to happen.",
          "definition": "static bool process_name",
          "detailed": "\n        ",
          "name": "process_name",
          "params": [
            "qctx",
            "mode",
            "name",
            "type",
            "only_if_a_exists"
          ],
          "static": true
        },
        {
          "args": "(const section_filter_t *filter)",
          "brief": "Apply the requested section filter, i.e. prevent (when possible, as determined by process_name()) RRsets of given 'type' from being rendered in the given 'section' of the response message stored in 'qctx'. Clear the AD bit if the answer and/or authority section was modified. If 'name' is NULL, all names in the given 'section' are processed; otherwise, only 'name' is. 'only_if_a_exists' is passed through to process_name().",
          "definition": "static void process_section",
          "detailed": "\n        ",
